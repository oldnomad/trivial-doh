{
    "name": "oldnomad/trivial-doh",
    "description": "Simple DoH server.",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "psalm/phar": "^6",
        "php-cs-fixer/shim": "^3",
        "php-parallel-lint/php-parallel-lint": "^1"
    },
    "authors": [
        {
            "name": "Alec Kojaev",
            "email": "alec@kojaev.name"
        }
    ],
    "scripts": {
        "cs": "php-cs-fixer fix --using-cache=no --dry-run --diff --show-progress=dots",
        "lint": "parallel-lint --show-deprecated src/",
        "psalm": "psalm.phar --config=psalm.xml --no-cache",
        "tests": [ "@cs", "@lint", "@psalm" ]
    }
}
